# Hugging Face write token for automated checkpoint syncing during training
# Obtain your token at: https://huggingface.co/settings/tokens
HF_TOKEN=hf_your_write_token_here

# Target repository on Hugging Face Hub (default: Cuong2004/HRP4K)
HF_REPO=Cuong2004/HRP4K

# Hugging Face Repository Type: dataset or model
HF_REPO_TYPE=dataset
